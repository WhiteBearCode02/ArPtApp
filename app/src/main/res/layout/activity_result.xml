<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/resultScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:clipToPadding="true"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/resultContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tvResultTitle"
            style="@style/TextAppearance.AIRPTCoach.Report.ScreenTitle"
            android:accessibilityHeading="true"
            android:text="@string/report_result_title" />

        <TextView
            style="@style/TextAppearance.AIRPTCoach.Report.BodyMuted"
            android:layout_marginTop="12dp"
            android:text="@string/report_result_description" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.AIRPTCoach.Report.Card"
            android:layout_marginTop="24dp">

            <LinearLayout style="@style/Widget.AIRPTCoach.Report.CardContent">

                <TextView
                    style="@style/TextAppearance.AIRPTCoach.Report.BodyMuted"
                    android:text="@string/report_result_count_label" />

                <TextView
                    android:id="@+id/tvFinalCount"
                    style="@style/TextAppearance.AIRPTCoach.Report.ScreenTitle"
                    android:layout_marginTop="8dp"
                    android:text="@string/report_result_count_default"
                    android:textColor="@color/aurora_ice"
                    android:textSize="40sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:importantForAccessibility="no" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewReport"
            style="@style/Widget.AIRPTCoach.Report.PrimaryButton"
            android:text="@string/report_result_open_report" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToMain"
            style="@style/Widget.AIRPTCoach.Report.SecondaryButton"
            android:layout_marginTop="12dp"
            android:text="@string/report_result_back_home" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
