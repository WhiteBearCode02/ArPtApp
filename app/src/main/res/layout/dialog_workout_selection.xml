<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_personal_reference_dialog"
    android:clipToPadding="false"
    android:fillViewport="false">

    <!-- One scroll surface keeps seven options, guidance and Cancel available at large font sizes. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvWorkoutSelectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/workout_selection_title"
            android:textColor="@color/white"
            android:textSize="22sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/workout_selection_description"
            android:textColor="@color/aurora_ice"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvWorkoutSelectionCameraView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_camera_status_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textColor="@color/aurora_mint"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/workoutSelectionOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/workoutSelectionGuidanceSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvWorkoutSelectionGuidance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:padding="12dp"
                android:textColor="@color/aurora_ice"
                android:textSize="15sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinueFrontWorkout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/workout_selection_continue_front"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:visibility="gone"
                app:backgroundTint="#345B77"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReturnToWorkoutSetup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/workout_selection_change_view"
                android:textAllCaps="false"
                android:textColor="@color/aurora_ice"
                android:visibility="gone"
                app:backgroundTint="#1C354F"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelWorkoutSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/workout_selection_cancel"
            android:textAllCaps="false"
            android:textColor="@color/aurora_ice"
            app:backgroundTint="#1C354F"
            app:cornerRadius="12dp" />
    </LinearLayout>
</ScrollView>
