<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reportScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:clipToPadding="true"
    android:fillViewport="true">

    <!-- Root insets protect system bars; all content stays within the same scroll flow. -->
    <LinearLayout
        android:id="@+id/reportContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/TextAppearance.AIRPTCoach.Report.ScreenTitle"
            android:accessibilityHeading="true"
            android:text="@string/report_screen_title" />

        <TextView
            android:id="@+id/tvExerciseType"
            style="@style/TextAppearance.AIRPTCoach.Report.SectionTitle"
            android:layout_marginTop="12dp"
            android:text="@string/report_exercise_default"
            android:textColor="@color/aurora_ice" />

        <TextView
            android:id="@+id/tvWorkoutDate"
            style="@style/TextAppearance.AIRPTCoach.Report.BodyMuted"
            android:layout_marginTop="4dp"
            android:text="@string/report_date_default" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.AIRPTCoach.Report.Card"
            android:layout_marginTop="20dp">

            <LinearLayout style="@style/Widget.AIRPTCoach.Report.CardContent">

                <TextView
                    style="@style/TextAppearance.AIRPTCoach.Report.SectionTitle"
                    android:accessibilityHeading="true"
                    android:text="@string/report_session_summary" />

                <!-- Flexible columns wrap enlarged fonts instead of clipping fixed-height cells. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTotalCount"
                        style="@style/TextAppearance.AIRPTCoach.Report.SummaryMetric"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="@string/report_count_default" />

                    <TextView
                        android:id="@+id/tvAvgScore"
                        style="@style/TextAppearance.AIRPTCoach.Report.SummaryMetric"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/report_score_default" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDuration"
                        style="@style/TextAppearance.AIRPTCoach.Report.SummaryMetric"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="@string/report_duration_default" />

                    <TextView
                        android:id="@+id/tvCalories"
                        style="@style/TextAppearance.AIRPTCoach.Report.SummaryMetric"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/report_calories_default" />
                </LinearLayout>

                <TextView
                    style="@style/TextAppearance.AIRPTCoach.Report.BodyMuted"
                    android:layout_marginTop="14dp"
                    android:text="@string/report_estimate_note" />

                <View
                    style="@style/Widget.AIRPTCoach.Report.Divider"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/tvFeedback"
                    style="@style/TextAppearance.AIRPTCoach.Report.Body"
                    android:layout_marginTop="14dp"
                    android:text="@string/report_summary_default" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/aiExplanationSection"
            style="@style/Widget.AIRPTCoach.Report.Card"
            android:layout_marginTop="16dp">

            <LinearLayout style="@style/Widget.AIRPTCoach.Report.CardContent">

                <TextView
                    style="@style/TextAppearance.AIRPTCoach.Report.SectionTitle"
                    android:accessibilityHeading="true"
                    android:text="@string/report_ai_title" />

                <TextView
                    style="@style/TextAppearance.AIRPTCoach.Report.BodyMuted"
                    android:layout_marginTop="6dp"
                    android:text="@string/report_ai_role" />

                <TextView
                    android:id="@+id/tvAiStatus"
                    style="@style/TextAppearance.AIRPTCoach.Report.Body"
                    android:layout_marginTop="12dp"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/report_ai_preparing_description" />

                <ProgressBar
                    android:id="@+id/aiProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="12dp"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGenerateAi"
                    style="@style/Widget.AIRPTCoach.Report.SecondaryButton"
                    android:layout_marginTop="12dp"
                    android:enabled="false"
                    android:text="@string/report_ai_preparing" />

                <TextView
                    android:id="@+id/tvAiReport"
                    style="@style/TextAppearance.AIRPTCoach.Report.Body"
                    android:layout_marginTop="14dp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextAppearance.AIRPTCoach.Report.SectionTitle"
            android:layout_marginTop="28dp"
            android:accessibilityHeading="true"
            android:text="@string/report_chart_title" />

        <TextView
            style="@style/TextAppearance.AIRPTCoach.Report.BodyMuted"
            android:layout_marginTop="6dp"
            android:text="@string/report_chart_role" />

        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/chart"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/report_chart_description" />

        <TextView
            android:id="@+id/tvChartEmpty"
            style="@style/TextAppearance.AIRPTCoach.Report.BodyMuted"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_report_note"
            android:padding="16dp"
            android:text="@string/report_chart_empty"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvRepDetailsHeader"
            style="@style/TextAppearance.AIRPTCoach.Report.SectionTitle"
            android:layout_marginTop="28dp"
            android:accessibilityHeading="true"
            android:text="@string/report_rep_section_title" />

        <TextView
            android:id="@+id/tvRepAnalysisNote"
            style="@style/TextAppearance.AIRPTCoach.Report.BodyMuted"
            android:layout_marginTop="6dp"
            android:text="@string/report_local_analysis_note" />

        <TextView
            android:id="@+id/tvRepEmpty"
            style="@style/TextAppearance.AIRPTCoach.Report.BodyMuted"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_report_note"
            android:padding="16dp"
            android:text="@string/report_reps_empty"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/repAnalysisContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/improvementSummarySection"
            style="@style/Widget.AIRPTCoach.Report.Card"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <LinearLayout style="@style/Widget.AIRPTCoach.Report.CardContent">

                <TextView
                    style="@style/TextAppearance.AIRPTCoach.Report.SectionTitle"
                    android:accessibilityHeading="true"
                    android:text="@string/report_improvement_summary_title" />

                <TextView
                    android:id="@+id/tvImprovementSummary"
                    style="@style/TextAppearance.AIRPTCoach.Report.Body"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Local developer-only aggregate diagnostics. Kept after all user coaching sections. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/yoloShadowSection"
            style="@style/Widget.AIRPTCoach.Report.Card"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <LinearLayout style="@style/Widget.AIRPTCoach.Report.CardContent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleYoloShadow"
                    style="@style/Widget.AIRPTCoach.Report.SecondaryButton"
                    android:text="@string/yolo_report_show" />

                <LinearLayout
                    android:id="@+id/yoloShadowDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/TextAppearance.AIRPTCoach.Report.SectionTitle"
                        android:layout_marginTop="12dp"
                        android:accessibilityHeading="true"
                        android:text="@string/yolo_report_title" />

                    <TextView
                        style="@style/TextAppearance.AIRPTCoach.Report.BodyMuted"
                        android:layout_marginTop="8dp"
                        android:text="@string/yolo_report_developer_note" />

                    <LinearLayout
                        android:id="@+id/yoloShadowMetricGroups"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClose"
            style="@style/Widget.AIRPTCoach.Report.PrimaryButton"
            android:layout_marginTop="24dp"
            android:text="@string/report_close" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
