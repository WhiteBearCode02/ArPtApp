<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="20"
                android:endColor="#102C67"
                android:centerColor="#0A183D"
                android:startColor="#081126" />
            <stroke android:width="1dp" android:color="#577ECB" />
        </shape>
    </item>
    <item android:gravity="end|top" android:right="-42dp" android:top="-46dp">
        <shape android:shape="oval">
            <size android:width="176dp" android:height="176dp" />
            <solid android:color="#1C5FAB" />
        </shape>
    </item>
</layer-list>
