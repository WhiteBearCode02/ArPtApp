<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.AIRPTCoach.Help.Card" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardBackgroundColor">#E60D2238</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/aurora_border</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="TextAppearance.AIRPTCoach.Help.SectionTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="TextAppearance.AIRPTCoach.Help.ItemTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/aurora_ice</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="TextAppearance.AIRPTCoach.Help.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
