<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 로그인·회원가입 화면에서 공통으로 사용하는 입력 필드 규격 -->
    <style name="Widget.AIRPTCoach.Auth.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="boxBackgroundColor">#A60A1D31</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/color_primary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="endIconTint">@color/text_secondary</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="startIconTint">@color/aurora_mint</item>
    </style>

    <!-- 모든 주요 인증 액션은 같은 높이·타이포그래피·모서리를 공유합니다. -->
    <style name="Widget.AIRPTCoach.Auth.ActionButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">16dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.AIRPTCoach.Auth.ActionButton.Primary">
        <item name="backgroundTint">@color/color_primary</item>
        <item name="rippleColor">#40FFFFFF</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.AIRPTCoach.Auth.ActionButton.Google">
        <item name="backgroundTint">@color/white</item>
        <item name="strokeColor">#DADCE0</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">#FF1F1F1F</item>
    </style>

    <style name="Widget.AIRPTCoach.Auth.ActionButton.Secondary">
        <item name="backgroundTint">#40173451</item>
        <item name="strokeColor">@color/aurora_mint</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/aurora_ice</item>
    </style>

    <style name="Widget.AIRPTCoach.Auth.LinkButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_height">48dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/aurora_mint</item>
        <item name="android:textSize">13sp</item>
        <item name="cornerRadius">14dp</item>
        <item name="rippleColor">#3381E8D3</item>
    </style>

</resources>
