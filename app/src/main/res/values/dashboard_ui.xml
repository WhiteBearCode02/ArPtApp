<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="dashboard_back">뒤로가기</string>
    <string name="dashboard_camera_view">방향 · 선택</string>
    <string name="dashboard_camera_view_compact_value">방향 · %1$s</string>
    <string name="dashboard_personal_reference">내 기준 기록</string>
    <string name="dashboard_pose_guide">측정 대기 · 전신이 화면에 들어오도록 위치를 조정해 주세요</string>
    <string name="dashboard_count_unit">회</string>
    <string name="dashboard_count_waiting">측정 대기</string>
    <string name="dashboard_yolo_view">YOLO 진단 보기</string>
    <string name="dashboard_yolo_expand">YOLO 진단 펼치기</string>
    <string name="dashboard_yolo_collapse">YOLO 진단 접기</string>
    <string name="dashboard_yolo_expanded_state">펼쳐짐</string>
    <string name="dashboard_yolo_collapsed_state">접힘</string>

    <!-- Small visual surface (8dp vertical insets) inside an accessible >=48dp touch target. -->
    <style name="Widget.AIRPTCoach.Dashboard.SetupChip" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/aurora_ice</item>
        <item name="android:textSize">12sp</item>
        <item name="android:singleLine">false</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:insetTop">8dp</item>
        <item name="android:insetBottom">8dp</item>
        <item name="backgroundTint">#20283F55</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">#406A9C9B</item>
        <item name="cornerRadius">12dp</item>
        <item name="rippleColor">#3381E8D3</item>
    </style>

    <style name="Widget.AIRPTCoach.Dashboard.DiagnosticToggle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/aurora_ice</item>
        <item name="android:textSize">12sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="cornerRadius">14dp</item>
        <item name="rippleColor">#3381E8D3</item>
    </style>

    <!-- Read-only workout context replaces editable settings while a session is running. -->
    <!-- No implicit dotted-name parent: Widget.AIRPTCoach.Dashboard does not exist. -->
    <style name="Widget.AIRPTCoach.Dashboard.SummaryText" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/aurora_ice</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Content-driven height prevents enlarged accessibility fonts from clipping the CTA. -->
    <style name="Widget.AIRPTCoach.Dashboard.ExerciseAction" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:elevation">4dp</item>
        <item name="android:backgroundTint">@null</item>
    </style>
</resources>
