<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="compatible"
        app:scaleType="fillCenter" />

    <com.example.arptapp.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <View
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_camera_top_scrim"
        android:clickable="false" />

    <!-- Wide screens retain a clear left camera area and independently scrollable right controls. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dashboardChrome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="4dp"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/dashboardPanelGuide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.54" />

        <LinearLayout
            android:id="@+id/layoutCameraHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_camera_icon_button"
                android:contentDescription="@string/dashboard_back"
                android:padding="12dp"
                android:src="@drawable/ic_dashboard_back"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/tvDashboardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/exercise_ready"
                    android:textColor="@color/white"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvCameraLens"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/camera_lens_connecting"
                    android:textColor="@color/aurora_ice"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnSwitchCamera"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_camera_icon_button"
                android:contentDescription="@string/camera_switch"
                android:padding="12dp"
                android:src="@drawable/ic_camera_flip"
                app:tint="@color/white" />
        </LinearLayout>

        <!-- Content grows vertically instead of overlapping the camera guide at larger font sizes. -->
        <ScrollView
            android:id="@+id/scrollDashboardGuide"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/dashboardPanelGuide"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutCameraHeader">

            <FrameLayout
                android:id="@+id/layoutPoseGuide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="96dp">

                <TextView
                    android:id="@+id/tvPoseFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:accessibilityLiveRegion="polite"
                    android:background="@drawable/bg_camera_status_chip"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="@string/dashboard_pose_guide"
                    android:textColor="@color/aurora_ice"
                    android:textSize="14sp" />
            </FrameLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/scrollDashboardContent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="vertical"
            app:layout_constraintBottom_toTopOf="@id/layoutCameraActions"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/dashboardPanelGuide"
            app:layout_constraintTop_toBottomOf="@id/layoutCameraHeader">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/layoutDetectedExercise"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_camera_status_chip"
                    android:gravity="center_vertical"
                    android:minHeight="36dp"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/bg_camera_live_dot" />

                    <TextView
                        android:id="@+id/tvDetectedExercise"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/exercise_detecting"
                        android:textColor="@color/aurora_ice"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutSetupOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_dashboard_glass_panel"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCameraView"
                        style="@style/Widget.AIRPTCoach.Dashboard.SetupRow"
                        android:text="@string/dashboard_camera_view" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="#4079C9D0"
                        android:importantForAccessibility="no" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPersonalReference"
                        style="@style/Widget.AIRPTCoach.Dashboard.SetupRow"
                        android:text="@string/dashboard_personal_reference" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_camera_count_panel"
                    android:gravity="center"
                    android:minWidth="148dp"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/exercise_count"
                        android:textColor="@color/aurora_ice"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-light"
                            android:includeFontPadding="false"
                            android:text="0"
                            android:textColor="@color/white"
                            android:textSize="36sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/dashboard_count_unit"
                            android:textColor="@color/aurora_ice"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCountUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/dashboard_count_waiting"
                        android:textColor="@color/aurora_ice"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutYoloDiagnostics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_dashboard_glass_panel"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnYoloDiagnosticsToggle"
                        style="@style/Widget.AIRPTCoach.Dashboard.DiagnosticToggle"
                        android:text="@string/dashboard_yolo_expand" />

                    <LinearLayout
                        android:id="@+id/layoutYoloDiagnosticsDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="12dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvPerformance"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/aurora_ice"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvYoloDiagnostics"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="monospace"
                            android:importantForAccessibility="no"
                            android:textColor="@color/aurora_ice"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <FrameLayout
            android:id="@+id/layoutCameraActions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/dashboardPanelGuide">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnStartExercise"
                style="@style/Widget.AIRPTCoach.Dashboard.ExerciseAction"
                android:background="@drawable/bg_camera_start_button"
                android:text="@string/exercise_start"
                android:textColor="#FF071426" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEndExercise"
                style="@style/Widget.AIRPTCoach.Dashboard.ExerciseAction"
                android:background="@drawable/bg_camera_end_button"
                android:text="@string/exercise_end"
                android:textColor="@color/white"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
